<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="estate_property_offer_list_view" model="ir.ui.view">
        <field name="name">estate.property.offer.list.view</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <list decoration-danger="status == 'refused'" decoration-success="status == 'accepted'" editable="bottom">
                <field name="price"/>
                <field name="partner_id"/>
                <field name="validity"/>
                <field name="date_deadline"/>
                <button name="action_accept_refuse" context="{'status': 'accept'}"
                        type="object"
                        invisible="property_state in ('sold', 'cancelled')"
                        icon="fa-check"/>
                <button name="action_accept_refuse"
                        invisible="property_state in ('sold', 'cancelled')"
                        context="{'status': 'refuse'}"
                        type="object" icon="fa-times"/>
                <field name="status"/>
            </list>
        </field>
    </record>
    <record id="estate_property_offer_action" model="ir.actions.act_window">
        <field name="name">Estate Property</field>
        <field name="res_model">estate.property.offer</field>
        <field name="view_mode">list</field>
        <field name="domain">[('property_type_id', '=', active_id)]</field>
    </record>
</odoo>