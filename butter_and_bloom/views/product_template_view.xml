<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="product_template_form_inherit_bab"
            model="ir.ui.view">
        <field name="name">
            product.template.form.inherit.bab
        </field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='type']" position="before">
                <field readonly="1" name="product_type"/>
            </xpath>
        </field>
    </record>

    <record id="view_product_template" model="ir.ui.view">
        <field name="name">view.product.template</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='categ_id']" position="before">
                    <field name="profit_margin"/>
                    <field name="profit_amount"/>
            </xpath>
        </field>
    </record>
</odoo>