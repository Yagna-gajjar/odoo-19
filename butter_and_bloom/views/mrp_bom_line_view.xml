<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="mrp_bom_line_view" model="ir.ui.view">
        <field name="name">mrp.bom.line.view</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='bom_line_ids']//field[@name='product_uom_id']"
                   position="after">
                <field name="total_quantity"/>
            </xpath>
        </field>
    </record>
</odoo>