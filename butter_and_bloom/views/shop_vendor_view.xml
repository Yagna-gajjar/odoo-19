<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="shop_vendor_list_view" model="ir.ui.view">
        <field name="name">shop.vendor.list.view</field>
        <field name="model">shop.vendor</field>
        <field name="arch" type="xml">
            <list>
                <field name="partner_id"/>
                <field name="allowed_product_lines_ids"/>
            </list>
        </field>
    </record>

    <record id="shop_vendor_form_view" model="ir.ui.view">
        <field name="name">shop.vendor.form.view</field>
        <field name="model">shop.vendor</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="company_id"/>
                        <field name="partner_id"/>
                        <field name="allowed_product_lines_ids"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="shop_vendor_action" model="ir.actions.act_window">
        <field name="name">Shop Vendor</field>
        <field name="res_model">shop.vendor</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>