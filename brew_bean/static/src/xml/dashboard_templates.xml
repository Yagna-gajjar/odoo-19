<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="CafeDashboard" name="Cafe Dashboard">
        <t t-call="web.layout">
            <t t-call-assets="web.assets_frontend" t-js="false"/>
            <CafeLayout title="'Dashboard'">

                <div class="cafe-dashboard">

                    <main class="cafe-main">

                        <header class="cafe-header">
                            <h1>Dashboard</h1>
                            <span>Welcome back!</span>
                        </header>

                        <section class="cafe-stats">

                            <div class="stat-card">
                                <h4>Today's Orders</h4>
                                <h2>48</h2>
                                <p>Orders received today</p>
                            </div>

                            <div class="stat-card">
                                <h4>Today's Revenue</h4>
                                <h2>₹12,500</h2>
                                <p>Total sales today</p>
                            </div>

                            <div class="stat-card">
                                <h4>Available Tables</h4>
                                <h2>8</h2>
                                <p>Ready for customers</p>
                            </div>

                            <div class="stat-card">
                                <h4>Active Orders</h4>
                                <h2>6</h2>
                                <p>Currently preparing</p>
                            </div>

                        </section>

                    </main>
                </div>

            </CafeLayout>
        </t>
    </template>
</odoo>


