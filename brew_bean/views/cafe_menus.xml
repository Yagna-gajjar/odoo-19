<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="menu_item_kanban_view" model="ir.ui.view">
        <field name="name">menu.item.kanban.view</field>
        <field name="model">menu.item</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="image"/>
                <field name="name"/>
                <field name="category"/>
                <field name="price"/>

                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card">
                            <div class="row">
                                <div class="col-4">
                                    <field name="image" widget="image"/>
                                </div>
                                <div class="col-8">
                                    <strong>
                                        <field name="name"/>
                                    </strong>
                                    <br/>
                                    <field name="category"/>
                                    <br/>
                                    <strong>
                                        ₹
                                        <field name="price"/>
                                    </strong>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="menu_item_form_view" model="ir.ui.view">
        <field name="name">menu.item.form.view</field>
        <field name="model">menu.item</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <p>
                        <h1>
                            <field name="name" placeholder="EX. Cold Brew"/>
                        </h1>
                    </p>
                    <group>
                        <field name="category"/>
                        <field name="image"/>
                        <field name="price"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="menu_item_action" model="ir.actions.act_window">
        <field name="name">Cafe Menu</field>
        <field name="res_model">menu.item</field>
        <field name="view_mode">kanban,form</field>
    </record>
</odoo>