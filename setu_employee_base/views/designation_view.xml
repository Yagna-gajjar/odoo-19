<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="designation_view" model="ir.ui.view">
        <field name="name">designation.view</field>
        <field name="model">designation</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>
    <record id="designation_form_view" model="ir.ui.view">
        <field name="name">designation.form</field>
        <field name="model">designation</field>
        <field name="arch" type="xml">
            <form string="designation Form">
                <sheet>
                    <group>
                        <field name="name" placeholder="Enter designation..."/>
                    </group>
                    <notebook>
                        <page string="Department info" name="department">
                            <group>
                                <field name="department_id" />
                            </group>
                        </page>
                        <page string="Employees info" name="employee_info">
                            <group>
                                <field name="employee_base_id">
                                    <list editable="bottom">
                                        <field name="name"/>
                                        <field name="profile"/>
                                        <field name="is_active"/>
                                        <field name="department_id" />
                                        <field name="salary"/>
                                        <field name="bonus"/>
                                    </list>
                                </field>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="designation_action" model="ir.actions.act_window">
        <field name="name">designation Base</field>
        <field name="res_model">designation</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>