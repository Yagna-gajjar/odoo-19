<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_setu_ai_schema_model_list" model="ir.ui.view">
        <field name="name">setu.ai.schema.model.list</field>
        <field name="model">setu.ai.schema.model</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false" decoration-muted="is_stale">
                <header>
                    <button name="action_synchronize_schema" type="object" string="Synchronize Schema" display="always" class="btn-primary" groups="base.group_system"/>
                </header>
                <field name="name"/>
                <field name="description"/>
                <field name="model_kind"/>
                <field name="module"/>
                <field name="table_name" optional="hide"/>
                <field name="is_custom" optional="hide"/>
                <field name="is_stale"/>
                <field name="last_sync"/>
            </list>
        </field>
    </record>

    <record id="view_setu_ai_schema_model_form" model="ir.ui.view">
        <field name="name">setu.ai.schema.model.form</field>
        <field name="model">setu.ai.schema.model</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <header>
                    <button name="action_synchronize_schema" type="object" string="Synchronize Schema" class="btn-primary" groups="base.group_system"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="description"/>
                            <field name="module"/>
                            <field name="model_kind"/>
                        </group>
                        <group>
                            <field name="table_name"/>
                            <field name="is_custom"/>
                            <field name="is_stale"/>
                            <field name="last_sync"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Fields" name="fields">
                            <field name="field_ids">
                                <list create="false" edit="false" delete="false" decoration-muted="is_stale">
                                    <field name="name"/>
                                    <field name="field_label"/>
                                    <field name="field_type"/>
                                    <field name="relation"/>
                                    <field name="store"/>
                                    <field name="is_computed"/>
                                    <field name="is_related"/>
                                    <field name="related_path" optional="hide"/>
                                    <field name="is_stale"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_setu_ai_schema_model_search" model="ir.ui.view">
        <field name="name">setu.ai.schema.model.search</field>
        <field name="model">setu.ai.schema.model</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="description"/>
                <field name="module"/>
                <filter name="filter_stale" string="Stale" domain="[('is_stale', '=', True)]"/>
                <filter name="filter_active_schema" string="Available" domain="[('is_stale', '=', False)]"/>
                <separator/>
                <filter name="filter_model" string="Persistent" domain="[('model_kind', '=', 'model')]"/>
                <filter name="filter_transient" string="Transient" domain="[('model_kind', '=', 'transient')]"/>
                <filter name="filter_abstract" string="Abstract" domain="[('model_kind', '=', 'abstract')]"/>
                <filter name="filter_manual" string="Manual" domain="[('model_kind', '=', 'manual')]"/>
                <filter name="filter_query" string="SQL View" domain="[('model_kind', '=', 'query')]"/>
                <group>
                    <filter name="group_kind" string="Kind" domain="[]" context="{'group_by': 'model_kind'}"/>
                    <filter name="group_module" string="Module" domain="[]" context="{'group_by': 'module'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_setu_ai_schema_model" model="ir.actions.act_window">
        <field name="name">Schema Models</field>
        <field name="res_model">setu.ai.schema.model</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No schema metadata yet</p>
            <p>Use Synchronize Schema to read models and fields from the Odoo registry.</p>
        </field>
    </record>

    <record id="view_setu_ai_schema_field_list" model="ir.ui.view">
        <field name="name">setu.ai.schema.field.list</field>
        <field name="model">setu.ai.schema.field</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false" decoration-muted="is_stale">
                <field name="schema_model_id"/>
                <field name="name"/>
                <field name="field_label"/>
                <field name="field_type"/>
                <field name="relation"/>
                <field name="store"/>
                <field name="is_computed"/>
                <field name="is_related"/>
                <field name="is_stale"/>
            </list>
        </field>
    </record>

    <record id="view_setu_ai_schema_field_form" model="ir.ui.view">
        <field name="name">setu.ai.schema.field.form</field>
        <field name="model">setu.ai.schema.field</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <group>
                            <field name="schema_model_id"/>
                            <field name="name"/>
                            <field name="field_label"/>
                            <field name="field_type"/>
                            <field name="relation"/>
                        </group>
                        <group>
                            <field name="store"/>
                            <field name="is_computed"/>
                            <field name="is_related"/>
                            <field name="related_path"/>
                            <field name="is_stale"/>
                        </group>
                    </group>
                    <group>
                        <field name="help"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_setu_ai_schema_field_search" model="ir.ui.view">
        <field name="name">setu.ai.schema.field.search</field>
        <field name="model">setu.ai.schema.field</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="field_label"/>
                <field name="schema_model_id"/>
                <field name="relation"/>
                <filter name="filter_stale" string="Stale" domain="[('is_stale', '=', True)]"/>
                <filter name="filter_stored" string="Stored" domain="[('store', '=', True)]"/>
                <filter name="filter_computed" string="Computed" domain="[('is_computed', '=', True)]"/>
                <filter name="filter_related" string="Related" domain="[('is_related', '=', True)]"/>
                <group>
                    <filter name="group_model" string="Model" domain="[]" context="{'group_by': 'schema_model_id'}"/>
                    <filter name="group_type" string="Type" domain="[]" context="{'group_by': 'field_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_setu_ai_schema_field" model="ir.actions.act_window">
        <field name="name">Schema Fields</field>
        <field name="res_model">setu.ai.schema.field</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_setu_ai_schema_root"
              name="AI Schema"
              parent="base.menu_administration"
              action="action_setu_ai_schema_model"
              sequence="40"
              groups="base.group_system"/>
    <menuitem id="menu_setu_ai_schema_model"
              name="Models"
              parent="menu_setu_ai_schema_root"
              action="action_setu_ai_schema_model"
              sequence="10"
              groups="base.group_system"/>
    <menuitem id="menu_setu_ai_schema_field"
              name="Fields"
              parent="menu_setu_ai_schema_root"
              action="action_setu_ai_schema_field"
              sequence="20"
              groups="base.group_system"/>
</odoo>
