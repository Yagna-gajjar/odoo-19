<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="rule_setu_ai_conversation_owner" model="ir.rule">
        <field name="name">AI conversations: own only</field>
        <field name="model_id" ref="model_setu_ai_conversation"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
    </record>
    <record id="rule_setu_ai_conversation_message_owner" model="ir.rule">
        <field name="name">AI conversation messages: own only</field>
        <field name="model_id" ref="model_setu_ai_conversation_message"/>
        <field name="domain_force">[('conversation_id.user_id', '=', user.id)]</field>
    </record>
</odoo>
