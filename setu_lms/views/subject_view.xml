<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="subject_list_view" model="ir.ui.view">
        <field name="name">Subject</field>
        <field name="model">subject</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
<!--                <field name="teacher_ids"/>-->
<!--                <field name="student_ids"/>-->
<!--                <field name="class_ids"/>-->
            </list>
        </field>
    </record>
    <record id="subject_form_view" model="ir.ui.view">
        <field name="name">Subject Form</field>
        <field name="model">subject</field>
        <field name="arch" type="xml">
            <form string="Subject Form">
                <group>
                    <field name="name"/>
                    <field name="code"/>
<!--                    <field name="teacher_ids"/>-->
<!--                    <field name="student_ids"/>-->
<!--                    <field name="class_ids"/>-->
                </group>
            </form>
        </field>
    </record>
    <record id="subject_action" model="ir.actions.act_window">
        <field name="name">Subject</field>
        <field name="res_model">subject</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>