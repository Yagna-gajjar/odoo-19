<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="student_attendance_list_view" model="ir.ui.view">
        <field name="name">student.attendance.list.view</field>
        <field name="model">student.attendance</field>
        <field name="arch" type="xml">
            <list>
                <field name="date"/>
                <field name="enrolled_student_id"/>
                <field name="state"/>
                <field name="remarks"/>
            </list>
        </field>
    </record>
    <record id="student_attendance_action" model="ir.actions.act_window">
        <field name="name">Attendance</field>
        <field name="res_model">student.attendance</field>
        <field name="view_mode">list</field>
    </record>
</odoo>