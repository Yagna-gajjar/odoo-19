<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="student_attendance_list_view" model="ir.ui.view">
        <field name="name">student.attendance.list.view</field>
        <field name="model">student.attendance</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="date"/>
                <field name="class_year_id"/>
                <field name="student_id"/>
                <field name="state"/>
                <field name="remarks"/>
            </list>
        </field>
    </record>

    <record id="student_attendance_form_view" model="ir.ui.view">
        <field name="name">student.attendance.form.view</field>
        <field name="model">student.attendance</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="date"/>
                        <field name="class_year_id"/>
                        <field name="student_id"/>
                        <field name="state"/>
                        <field name="remarks"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="student_attendance_search_view" model="ir.ui.view">
        <field name="name">student.attendance.search.view</field>
        <field name="model">student.attendance</field>
        <field name="arch" type="xml">
            <search string="Search Attendance">
                <field name="student_id"/>
                <field name="class_year_id"/>
                <field name="date"/>
                <filter name="today" string="Today" domain="[('date','=',context_today())]"/>
                <filter name="absent" string="Absent" domain="[('state','=','absent')]"/>
                <filter name="group_class" string="Class" context="{'group_by':'class_year_id'}"/>
                <filter name="group_date" string="Date" context="{'group_by':'date'}"/>
                <filter name="group_state" string="Status" context="{'group_by':'state'}"/>
            </search>
        </field>
    </record>

    <record id="student_attendance_action" model="ir.actions.act_window">
        <field name="name">Attendance</field>
        <field name="res_model">student.attendance</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>