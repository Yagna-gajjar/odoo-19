<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="attendance_wizard_form_view" model="ir.ui.view">
        <field name="name">attendance.wizard.form.view</field>
        <field name="model">attendance.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="date"/>
                    <field name="class_year_id"/>
                </group>

                <field name="line_ids">
                    <list editable="bottom">
                        <field name="student_enrollment_id" column_invisible="1"/>
                        <field name="student_name" readonly="1"/>
                        <field name="class_year_name" readonly="1"/>
                        <field name="state"
                               widget="radio"
                               options="{'horizontal': true}"/>
                        <field name="remarks"/>
                    </list>
                </field>

                <footer>
                    <button name="action_save_attendance"
                            type="object"
                            string="Save Attendance"
                            class="btn-primary"/>

                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="attendance_wizard_action" model="ir.actions.act_window">
        <field name="name">Take Attendance</field>
        <field name="res_model">attendance.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>