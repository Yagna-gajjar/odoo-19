<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="student_enrollment_list_view" model="ir.ui.view">
        <field name="name">student.enrollment.list.view</field>
        <field name="model">student.enrollment</field>
        <field name="arch" type="xml">
            <list>
                <field name="enrollment_no"/>
                <field name="class_term_id"/>
                <field name="student_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="status"/>
            </list>
        </field>
    </record>
    <record id="student_enrollment_form_view" model="ir.ui.view">
        <field name="name">student.enrollment.form.view</field>
        <field name="model">student.enrollment</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="enrollment_no"/>
                    <field name="class_term_id"/>
                    <field name="student_id"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                    <field name="status"/>
                </group>
            </form>
        </field>
    </record>
    <record id="student_enrollment_action" model="ir.actions.act_window">
        <field name="name">Student Enrollment</field>
        <field name="res_model">student.enrollment</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>