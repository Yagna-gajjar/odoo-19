<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="exam_result_list_view" model="ir.ui.view">
        <field name="name">exam.result.list.view</field>
        <field name="model">exam.result</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="exam_id"/>
                <field name="class_year_id"/>
                <field name="subject_id"/>
                <field name="student_id"/>
                <field name="marks_obtained"/>
                <field name="max_marks" readonly="1"/>
                <field name="percentage" readonly="1"/>
                <field name="result_state" readonly="1"/>
            </list>
        </field>
    </record>

    <record id="exam_result_search_view" model="ir.ui.view">
        <field name="name">exam.result.search.view</field>
        <field name="model">exam.result</field>
        <field name="arch" type="xml">
            <search string="Search Results">
                <field name="student_id"/>
                <field name="exam_id"/>
                <filter name="failed" string="Failed" domain="[('result_state','=','fail')]"/>
<!--                <group expand="0" string="Group By">-->
<!--                    <filter name="group_exam" string="Exam" context="{'group_by':'exam_id'}"/>-->
<!--                    <filter name="group_result" string="Result" context="{'group_by':'result_state'}"/>-->
<!--                </group>-->
            </search>
        </field>
    </record>

    <record id="exam_result_action" model="ir.actions.act_window">
        <field name="name">Results</field>
        <field name="res_model">exam.result</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>