<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="class_subject_add_wizard_form_view" model="ir.ui.view">
        <field name="name">class.subject.add.wizard.form.view</field>
        <field name="model">class.subject.add.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="class_year_id" readonly="1"/>
                    <field name="subject_ids" widget="many2many_tags"/>
                </group>
                <footer>
                    <button name="action_add_subjects" type="object" string="Add Subjects" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="class_subject_add_wizard_action" model="ir.actions.act_window">
        <field name="name">Add Subjects</field>
        <field name="res_model">class.subject.add.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>