<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="class_term_list_view" model="ir.ui.view">
        <field name="name">class.term.list.view</field>
        <field name="model">class.term</field>
        <field name="arch" type="xml">
            <list>
                <field name="class_id"/>
                <field name="term_id"/>
            </list>
        </field>
    </record>
    <record id="class_term_action" model="ir.actions.act_window">
        <field name="name">Classes</field>
        <field name="res_model">class.term</field>
        <field name="view_mode">list</field>
        <field name="domain">[('status', '=', 'active')]</field>
    </record>
</odoo>