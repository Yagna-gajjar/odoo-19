<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="school_class_list_view" model="ir.ui.view">
        <field name="name">school.class.list.view</field>
        <field name="model">school.class</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="status"/>
            </list>
        </field>
    </record>
    <record id="school_class_form_view" model="ir.ui.view">
        <field name="name">school.class.form.view</field>
        <field name="model">school.class</field>
        <field name="arch" type="xml">
            <form string="Class Form">
                <group>
                <field name="name"/>
                <field name="code"/>
                <field name="status"/>
                </group>
            </form>
        </field>
    </record>
    <record id="class_action" model="ir.actions.act_window">
        <field name="name">Classes</field>
        <field name="res_model">school.class</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>