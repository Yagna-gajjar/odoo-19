<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="exam_list_view" model="ir.ui.view">
        <field name="name">exam.list.view</field>
        <field name="model">exam</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="class_year_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="exam_form_view" model="ir.ui.view">
        <field name="name">exam.form.view</field>
        <field name="model">exam</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_generate_result_sheets" type="object" string="Generate Result Sheets" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="class_year_id"/>
                        <field name="start_date"/>
                        <field name="end_date"/>
                        <field name="active"/>
                    </group>
                    <group string="Subjects">
                        <field name="exam_subject_ids">
                            <list editable="bottom">
                                <field name="class_subject_id"/>
                                <field name="max_marks"/>
                                <field name="passing_marks"/>
                                <field name="exam_date"/>
                            </list>
                        </field>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="exam_action" model="ir.actions.act_window">
        <field name="name">Exams</field>
        <field name="res_model">exam</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>