<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="academic_year_list_view" model="ir.ui.view">
        <field name="name">academic.year.list.view</field>
        <field name="model">academic.year</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="academic_year_form_view" model="ir.ui.view">
        <field name="name">academic.year.form.view</field>
        <field name="model">academic.year</field>
        <field name="arch" type="xml">
            <form string="Year">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="start_date"/>
                        <field name="end_date"/>
                        <field name="active"/>
                    </group>
                    <group>
                        <field name="class_year_ids">
                            <list>
                                <field name="class_id"/>
                                <field name="current_class_teacher_id"/>
                            </list>
                            <form>
                                <sheet>
                                    <group>
                                        <field name="class_id"/>
                                        <field name="current_class_teacher_id"/>
                                    </group>

                                    <group string="Subjects">
                                        <field name="class_subject_ids">
                                            <list editable="bottom">
                                                <field name="subject_id"/>
                                            </list>
                                        </field>
                                    </group>
                                </sheet>
                            </form>
                        </field>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="academic_year_action" model="ir.actions.act_window">
        <field name="name">Academic Year</field>
        <field name="res_model">academic.year</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>