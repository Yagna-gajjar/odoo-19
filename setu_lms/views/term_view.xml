<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="school_term_list_view" model="ir.ui.view">
        <field name="name">school.term.list.view</field>
        <field name="model">school.term</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="status"/>
            </list>
        </field>
    </record>
    <record id="school_term_form_view" model="ir.ui.view">
        <field name="name">school.term.form.view</field>
        <field name="model">school.term</field>
        <field name="arch" type="xml">
            <form string="Class Form">
                <group>
                    <field name="name"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                    <field name="status"/>
                </group>
            </form>
        </field>
    </record>
    <record id="term_action" model="ir.actions.act_window">
        <field name="name">Term</field>
        <field name="res_model">school.term</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>