<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="teacher_list_view" model="ir.ui.view">
        <field name="name">Teacher</field>
        <field name="model">teacher</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="employee_no"/>
                <field name="class_teacher_id"/>
                <field name="email"/>
                <field name="phone"/>
            </list>
        </field>
    </record>
    <record id="teacher_form_view" model="ir.ui.view">
        <field name="name">Teacher Form</field>
        <field name="model">teacher</field>
        <field name="arch" type="xml">
            <form string="Teacher Form">
                <header>
                    <button name="%(teacher_subject_add_wizard_action)d" type="action" string="Add Class Subjects"
                            class="btn-primary" context="{'default_teacher_id': id}"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="employee_no"/>
                        <field name="email"/>
                        <field name="phone"/>
                    </group>
                    <notebook>
                        <page string="Class Teacher">
                            <field name="class_teacher_id" readonly="1">
                                <list>
                                    <field name="class_year_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Class Subjects" name="class_subject">
                            <field name="class_subject_id" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="teacher_action" model="ir.actions.act_window">
        <field name="name">Teacher</field>
        <field name="res_model">teacher</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>