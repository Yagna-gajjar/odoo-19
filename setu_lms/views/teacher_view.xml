<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="teacher_list_view" model="ir.ui.view">
        <field name="name">Teacher</field>
        <field name="model">teacher</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="employee_no"/>
                <field name="class_term_id"/>
                <field name="email"/>
                <field name="phone"/>
            </list>
        </field>
    </record>
    <record id="teacher_form_view" model="ir.ui.view">
        <field name="name">Teacher Form</field>
        <field name="model">teacher</field>
        <field name="arch" type="xml">
            <form string="Teacher Form">
                <sheet>
                <group>
                    <field name="name"/>
                    <field name="employee_no"/>
                    <field name="email"/>
                    <field name="phone"/>
                </group>
                    <notebook>
                        <page string="Class Teacher" name="class_teacher">
                            <field name="class_term_id"/>
                        </page>
                        <page string="Class Subjects" name="class_subject">
                            <field name="class_subject_id"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="teacher_action" model="ir.actions.act_window">
        <field name="name">Teacher</field>
        <field name="res_model">teacher</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>