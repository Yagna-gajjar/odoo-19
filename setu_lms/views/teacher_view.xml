<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="teacher_list_view" model="ir.ui.view">
        <field name="name">Teacher</field>
        <field name="model">teacher</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="employee_no"/>
                <field name="email"/>
                <field name="phone"/>
<!--                <field name="subject_names"/>-->
<!--                <field name="class_names"/>-->
<!--                <field name="student_ids"/>-->
            </list>
        </field>
    </record>
    <record id="teacher_form_view" model="ir.ui.view">
        <field name="name">Teacher Form</field>
        <field name="model">teacher</field>
        <field name="arch" type="xml">
            <form string="Teacher Form">
                <group>
                    <field name="name"/>
                    <field name="employee_no"/>
                    <field name="email"/>
                    <field name="phone"/>
<!--                    <field name="subject_ids"/>-->
<!--                    <field name="class_ids"/>-->
<!--                    <field name="student_ids"/>-->
                </group>
            </form>
        </field>
    </record>
    <record id="teacher_action" model="ir.actions.act_window">
        <field name="name">Teacher</field>
        <field name="res_model">teacher</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>