<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="class_teacher_assignment_list_view" model="ir.ui.view">
        <field name="name">class.teacher.assignment.list.view</field>
        <field name="model">class.teacher.assignment</field>
        <field name="arch" type="xml">
            <list>
                <field name="class_term_id"/>
                <field name="teacher_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="status"/>
            </list>
        </field>
    </record>
    <record id="class_teacher_assignment_form_view" model="ir.ui.view">
        <field name="name">class.teacher.assignment.form.view</field>
        <field name="model">class.teacher.assignment</field>
        <field name="arch" type="xml">
            <form>
                <group>
                <field name="class_term_id"/>
                <field name="teacher_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="status"/>
                </group>
            </form>
        </field>
    </record>
    <record id="class_teacher_assignment_action" model="ir.actions.act_window">
        <field name="name">Class Teachers</field>
        <field name="res_model">class.teacher.assignment</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>