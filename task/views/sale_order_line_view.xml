<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_order_form_inherit_line_button" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.line.button</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='order_lines']//field[@name='order_line']/list//field[@name='product_id']"
                   position="after">
                <button name="action_show_specification"
                        type="object"
                        icon="fa-external-link-square"/>
            </xpath>
        </field>
    </record>
</odoo>
