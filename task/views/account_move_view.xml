<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="account_move_view_form" model="ir.ui.view">
        <field name="name">account.move.view.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <header>
                <button name="calculate_tax_amount"
                        invisible="state != 'posted'"
                        type="object"
                        string="Calculate Tax"
                        class="btn-primary"/>
            </header>
            <xpath expr="//field[@name='invoice_date']" position="before">
                <field name="tax_id" invisible="state != 'posted'" />
                <field name="tax_amount" invisible="state != 'posted'" />
            </xpath>
        </field>
    </record>
</odoo>
