<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="employee_leave_type_list_view" model="ir.ui.view">
        <field name="name">employee.leave.type.list.view</field>
        <field name="model">employee.leave.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="max_days"/>
                <field name="requires_approval"/>
            </list>
        </field>
    </record>
    <record id="employee_leave_type_form_view" model="ir.ui.view">
        <field name="name">employee.leave.type.form.view</field>
        <field name="model">employee.leave.type</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="max_days"/>
                    <field name="requires_approval"/>
                </group>
            </form>
        </field>
    </record>
    <record id="employee_leave_type_action" model="ir.actions.act_window">
        <field name="name">Employee Leave</field>
        <field name="res_model">employee.leave.type</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>