<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="employee_asset_list_view" model="ir.ui.view">
        <field name="name">employee.asset.list.view</field>
        <field name="model">employee.asset</field>
        <field name="arch" type="xml">
            <list>
                <field name="product_id"/>
                <field name="total"/>
                <field name="occupied"/>
            </list>
        </field>
    </record>
    <record id="employee_asset_form_view" model="ir.ui.view">
        <field name="name">employee.asset.form.view</field>
        <field name="model">employee.asset</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="product_id"/>
                        <field name="total"/>
                        <field name="occupied"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="employee_asset_action" model="ir.actions.act_window">
        <field name="name">Employee Assets</field>
        <field name="res_model">employee.asset</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>