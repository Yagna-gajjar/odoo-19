<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_product_variant_wizard_form" model="ir.ui.view">
        <field name="name">product.variant.wizard.form</field>
        <field name="model">product.variant.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Product Variant">

                <group>
                    <field name="product_tmpl_id"/>
                </group>

                <separator string="Select Attribute Values"/>

                <field name="line_ids">
                    <list editable="bottom" create="0" delete="0">
                        <field name="attribute_line_id"/>
                        <field name="value_id"/>
                    </list>
                </field>

                <footer>
                    <button
                        name="action_create_variant"
                        string="Create Product"
                        type="object"
                        class="btn-primary"
                    />

                    <button
                        string="Cancel"
                        special="cancel"
                        class="btn-secondary"
                    />
                </footer>

            </form>
        </field>
    </record>

    <record id="view_product_template_manual_variant" model="ir.ui.view">
        <field name="name">product.template.manual.variant</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">

            <xpath expr="//sheet" position="before">
                <header>
                    <button
                        name="action_open_manual_variant_wizard"
                        string="Create Variant"
                        type="object"
                        class="btn-primary"
                        invisible="not attribute_line_ids"
                    />
                </header>
            </xpath>

        </field>
    </record>

</odoo>
