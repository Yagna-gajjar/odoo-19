<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="sales_order_view_form" model="ir.ui.view">
        <field name="name">sales.order.view.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <header>
                <button name="update_sale_specification"
                        invisible="state != 'draft'"
                        type="object"
                        string="Update Specification"
                        class="btn-secondary"/>
            </header>
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="urgent_order"/>
                <field name="transfer"/>
                <field name="invoicing"/>
            </xpath>
            <xpath expr="//field[@name='sale_order_template_id']" position="after">
                <field name="profit_amount"/>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="domain">[('is_customer', '=', True), ('active', '=', True)]</attribute>
            </xpath>
        </field>
    </record>
</odoo>