<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="purchase_order_view_form" model="ir.ui.view">
        <field name="name">purchase.order.view.form</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='effective_date']" position="after">
                <field name="urgent_order"/>
                <field name="transfer"/>
                <field name="invoicing"/>
            </xpath>
            <xpath expr="//field[@name='currency_id']" position="after">
                <field name="allowed_vendors_products_id"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Allowed Product">
                    <field name="allowed_product_lines_ids">
                        <list edit="0">
                            <field name="product_id"/>
                            <field name="quantity"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>