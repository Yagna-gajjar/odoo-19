<?xml version="1.0" encoding="UTF-8" ?>

<templates xml:space="preserve">
    <t t-name="coffee_shop_core.AppLayout">
        <div class="coffee-app">
            <div class="coffee-body">
               <aside class="coffee-sidebar">
                <div class="coffee-logo">
                    <img
                            src="/coffee_shop_core/static/img/coffee_shop.png"
                            alt="Coffee Shop Logo"
                    />
                </div>
                   <div class="sidebar-heading">MENU</div>
                   <div class="sidebar-item"
                        t-att-class="{'active': state.activeMenu === 'shops'}"
                        t-on-click="() => selectMenu('shops')">
                   <i class="fa fa-building"/>
                       <span>Shops</span>
                </div>
            </aside>
                <main class="coffee-content">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h2>Shops</h2>

                        <button type="button"
                                class="btn btn-primary"
                                t-on-click="() => this.createShop()">
                            <i class="fa fa-plus me-2"/>
                            Create New Shop
                        </button>
                    </div>
                    <t t-if="state.loading">
                        <p>Loading shops...</p>
                    </t>
                    <t t-elif="state.error">
                        <p>Unable to load shops.</p>
                        <button class="btn btn-primary" t-on-click="loadShops">
                        Retry
                        </button>
                    </t>
                    <t t-elif="state.shops.length === 0">
                        <p>No coffee shops found.</p>
                    </t>
                    <t t-else="">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Shop Name</th>
                                    <th>Code</th>
                                    <th>Manager</th>
                                    <th>Status</th>
                                </tr>
                            </thead>

                            <tbody>
                                <tr t-foreach="state.shops"
                                    t-as="shop"
                                    t-key="shop.id">

                                    <td t-esc="shop.name"/>
                                    <td t-esc="shop.code"/>

                                    <td t-esc="shop.manager_id ? shop.manager_id[1] : '-'"/>

                                    <td>
                                        <span t-if="shop.active"
                                              class="badge text-bg-success">
                                            Active
                                        </span>
                                        <span t-else=""
                                              class="badge text-bg-secondary">
                                            Archived
                                        </span>
                                    </td>

                                </tr>
                            </tbody>
                        </table>
                    </t>
                </main>
        </div>
    </div>
</t>
</templates>