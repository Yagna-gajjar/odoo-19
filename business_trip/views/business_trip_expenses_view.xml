<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="business_trip_expense_list_view" model="ir.ui.view">
        <field name="name">business.trip.expense.list.view</field>
        <field name="model">business.trip.expense</field>
        <field name="arch" type="xml">
            <list>
                <field name="trip_id"/>
                <field name="expense_type"/>
                <field name="expense_date"/>
                <field name="amount"/>
                <field name="currency_id"/>
                <field name="description"/>
                <field name="receipt_reference"/>
            </list>
        </field>
    </record>
    <record id="business_trip_expense_form_view" model="ir.ui.view">
        <field name="name">business.trip.expense.form.view</field>
        <field name="model">business.trip.expense</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="change_expense_state"
                            context="{'state': 'submitted'}"
                            string="Submit"
                            invisible="state != 'draft'"
                            type="object"
                            class="btn-primary"/>
                    <button name="change_expense_state"
                            context="{'state': 'approved'}"
                            string="Approved"
                            invisible="state != 'submitted'"
                            type="object"
                            class="btn-primary"/>
                    <button name="change_expense_state"
                            context="{'state': 'rejected'}"
                            string="Rejected"
                            invisible="state in ('rejected')"
                            type="object"
                            class="btn-secondary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved"/>
                </header>
                <sheet>
                    <a>Expense Description</a>
                    <p>
                        <h1>
                            <field name="description"/>
                        </h1>
                    </p>
                    <group>
                        <group>
                            <field name="expense_type"/>
                            <field name="expense_date"/>
                            <field name="receipt_reference"/>
                            <field name="number_of_employee" />
                            <field name="distribute_equally"/>
                            <field name="all_employees"/>
                        </group>
                        <group>
                            <field name="amount"/>
                            <field name="remaining_amount" decoration-danger="remaining_amount &lt; 0"
                                   invisible="per_or_amount != 'amount'"/>

                            <field name="remaining_percentage" decoration-danger="remaining_percentage &lt; 0"
                                   invisible="per_or_amount != 'percentage'"/>
                            <field name="currency_id"/>
                            <field name="trip_employee_ids" invisible="1"/>
                            <field name="paid_by"/>
                            <field name="company_sponsored"/>
                            <field name="per_or_amount"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Share">
                            <field name="share_employees_ids">
                                <list editable="bottom">
                                    <field name="employee_ids" domain="[('id', 'in', parent.trip_employee_ids)]"/>
                                    <field name="trip_expense_id" column_invisible="1"/>
                                    <field name="percentage"
                                           readonly="distribute_equally or per_or_amount == 'amount'"/>
                                    <field name="amount"
                                           readonly="distribute_equally or per_or_amount == 'percentage'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="business_trip_expenses_action" model="ir.actions.act_window">
        <field name="name">Business Trip</field>
        <field name="res_model">business.trip.expense</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>