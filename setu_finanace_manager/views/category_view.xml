<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="category_list_view" model="ir.ui.view">
        <field name="name">category.list.view</field>
        <field name="model">category</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="category_type"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="category_form_view" model="ir.ui.view">
        <field name="name">category.form.view</field>
        <field name="model">category</field>
        <field name="arch" type="xml">
            <form>
                <group>
                <field name="name"/>
                <field name="category_type"/>
                <field name="active"/>
                </group>
            </form>
        </field>
    </record>
    <record id="category_action" model="ir.actions.act_window">
        <field name="name">Category</field>
        <field name="res_model">category</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>