<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="accounts_list_view" model="ir.ui.view">
        <field name="name">accounts.list.view</field>
        <field name="model">accounts</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="account_type"/>
                <field name="opening_balance"/>
                <field name="current_balance"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="accounts_form_view" model="ir.ui.view">
        <field name="name">accounts.form.view</field>
        <field name="model">accounts</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="name"/>
                    <field name="account_type"/>
                    <field name="opening_balance"/>
                    <field name="current_balance"/>
                    <field name="active"/>
                </group>
            </form>
        </field>
    </record>
    <record id="accounts_action" model="ir.actions.act_window">
        <field name="name">Accounts</field>
        <field name="res_model">accounts</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>